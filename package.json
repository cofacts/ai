{
  "name": "cofacts-ai",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "concurrently \"pnpm run dev:ui\" \"pnpm run dev:agent\" --names ui,agent --prefix-colors blue,green --kill-others",
    "dev:ui": "vite dev --port 3000",
    "dev:agent": "uv run --directory adk uvicorn main:app --port 8000 --reload --reload-dir cofacts_ai",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint",
    "format": "prettier",
    "check": "prettier --write . && eslint --fix",
    "install:agent": "uv sync --project adk",
    "typegen": "openapi-typescript http://localhost:8000/openapi.json -o src/lib/adk-types.d.ts && sed -i '' 's/: unknown/: {}/g' src/lib/adk-types.d.ts",
    "codegen": "graphql-codegen",
    "tokens": "node scripts/build-tokens.ts",
    "tokens:check": "node scripts/build-tokens.ts --check",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@fontsource-variable/noto-sans": "^5.2.10",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-devtools": "^0.7.0",
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.4",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.7",
    "@tanstack/router-plugin": "^1.169.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.3",
    "langfuse": "^3.38.20",
    "lucide-react": "^0.574.0",
    "nitro": "3.0.1-alpha.2",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-peeps": "0.1.10",
    "remark-gfm": "^4.0.1",
    "shadcn": "^3.8.5",
    "string-similarity": "^4.0.4",
    "tailwind-merge": "^3.4.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.0.0",
    "@graphql-codegen/client-preset": "^6.0.0",
    "@storybook/addon-a11y": "10.6.9",
    "@storybook/addon-docs": "10.6.9",
    "@storybook/addon-vitest": "10.6.9",
    "@storybook/tanstack-react": "10.6.9",
    "@tanstack/devtools-vite": "^0.8.7",
    "@tanstack/eslint-config": "^0.3.0",
    "@tanstack/react-query-devtools": "^5.108.4",
    "@tanstack/start-client-core": "1.170.39",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/string-similarity": "^4.0.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser": "4.1.9",
    "@vitest/browser-playwright": "4.1.9",
    "@vitest/coverage-v8": "4.1.9",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "graphql": "^16.13.2",
    "jsdom": "^27.0.0",
    "material-symbols": "0.48.2",
    "openapi-typescript": "^7.13.0",
    "playwright": "1.63.0",
    "prettier": "^3.5.3",
    "storybook": "10.6.9",
    "typescript": "^5.7.2",
    "vite": "^8.3.8",
    "vitest": "4.1.9",
    "web-vitals": "^5.1.0"
  }
}
