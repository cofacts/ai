
# Server-side (required) — rumors-api base URL for the BFF auth + GraphQL proxy
COFACTS_API_URL=https://dev-api.cofacts.tw

# Server-side (optional) — where a Cofacts article is read by a human.
# Derived from COFACTS_API_URL by dropping the api subdomain
# (dev-api.cofacts.tw -> dev.cofacts.tw), which is right for every current
# deployment. Set this only for one that does not follow that convention.
# COFACTS_SITE_URL=https://dev.cofacts.tw

# Server-side (optional) — ADK agent URL, defaults to http://localhost:8000
# ADK_URL=http://localhost:8000

# Server-side (optional) — Langfuse keys for reading back user feedback scores.
# Required to persist thumbs-up/down across reloads. Secret key MUST stay
# server-side; all Langfuse traffic is proxied through the BFF.
LANGFUSE_BASE_URL=https://langfuse.cofacts.tw
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# Tags scores with the environment they came from (local/preview/production),
# so they can be filtered separately from other environments in Langfuse.
LANGFUSE_TRACING_ENVIRONMENT=local
